{
  "name": "@present-day/scroll-area",
  "version": "0.1.1",
  "description": "A Radix or Base UI scroll area with theme-aware edge fades and shadows",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./radix": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./base-ui": {
      "import": {
        "types": "./dist/base-ui.d.mts",
        "default": "./dist/base-ui.mjs"
      },
      "require": {
        "types": "./dist/base-ui.d.ts",
        "default": "./dist/base-ui.js"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "bun@1.3.13",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "bun run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "react",
    "scroll-area",
    "radix",
    "base-ui",
    "scroll-shadow",
    "fade"
  ],
  "author": "Present Day",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/present-day/scroll-area.git"
  },
  "bugs": {
    "url": "https://github.com/present-day/scroll-area/issues"
  },
  "homepage": "https://github.com/present-day/scroll-area#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.0.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@biomejs/biome": "^2.4.12",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.9.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.6"
  },
  "peerDependenciesMeta": {
    "@base-ui/react": {
      "optional": true
    },
    "@radix-ui/react-scroll-area": {
      "optional": true
    }
  }
}
